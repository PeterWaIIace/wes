#!/usr/bin/env python3
"""Shared helper for the mock SLURM tools: job table updates."""
import sys
from pathlib import Path

state = Path(__import__("os").environ.get("WESHUB_MOCK_STATE", "/dev/null"))


def set_state(job_id: str, new_state: str) -> None:
    if not state.exists():
        return
    lines = []
    for line in state.read_text().splitlines():
        parts = line.split("|")
        if parts and parts[0] == job_id:
            parts[2] = new_state
            line = "|".join(parts)
        lines.append(line)
    state.write_text("\n".join(lines) + "\n")


if __name__ == "__main__":
    if len(sys.argv) >= 3 and sys.argv[1] == "set-state":
        set_state(sys.argv[2], sys.argv[3])
    else:
        print("usage: mockjob set-state <id> <state>", file=sys.stderr)
        sys.exit(1)
