#!/usr/bin/env python3
"""Mock sbatch: register a job, run it in the background, print "<id>;mock"."""
import os
import sys
import time
from pathlib import Path

state = Path(os.environ["WESHUB_MOCK_STATE"])
state.parent.mkdir(parents=True, exist_ok=True)

name = "mockjob"
script = None
parsable = False
args = sys.argv[1:]
i = 0
while i < len(args):
    a = args[i]
    if a == "--parsable":
        parsable = True
    elif a.startswith("--job-name="):
        name = a.split("=", 1)[1]
    elif a == "--job-name":
        i += 1
        name = args[i]
    elif not a.startswith("-"):
        script = a
    i += 1

if script is None:
    print("sbatch: no script given", file=sys.stderr)
    sys.exit(1)

last_id = 0
if state.exists():
    for line in state.read_text().splitlines():
        if line.strip():
            try:
                last_id = max(last_id, int(line.split("|")[0]))
            except ValueError:
                pass
job_id = last_id + 1

jobdir = os.getcwd()
line = f"{job_id}|{name}|PENDING|{time.time()}|{jobdir}"
with open(state, "a") as f:
    f.write(line + "\n")

worker = f"""#!/bin/bash
sleep 1
"{Path(__file__).parent / 'mockjob'}" set-state {job_id} RUNNING
SLURM_JOB_ID={job_id} SLURM_JOB_NAME={name} SLURM_NODELIST=mock-node1 SLURM_JOB_PARTITION=mock bash {script} > job_output.txt 2> job_error.txt
rc=$?
if [ $rc -eq 0 ]; then
    "{Path(__file__).parent / 'mockjob'}" set-state {job_id} COMPLETED
else
    "{Path(__file__).parent / 'mockjob'}" set-state {job_id} FAILED
fi
"""

workdir = Path(os.environ.get("WESHUB_MOCK_CLUSTER", ".")) / ".mock-workers"
workdir.mkdir(parents=True, exist_ok=True)
worker_path = workdir / f"worker-{job_id}.sh"
worker_path.write_text(worker)

import subprocess

subprocess.Popen(
    ["setsid", "bash", str(worker_path)],
    stdin=subprocess.DEVNULL,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
    start_new_session=True,
    cwd=jobdir,
)

if parsable:
    print(f"{job_id};mock")
else:
    print(f"Submitted batch job {job_id}")
