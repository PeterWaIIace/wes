#!/usr/bin/env python3
"""Mock scancel: mark a job CANCELLED in the job table."""
import os
import sys
from pathlib import Path

if len(sys.argv) < 2:
    print("scancel: need a job id", file=sys.stderr)
    sys.exit(1)

state = Path(os.environ.get("WESHUB_MOCK_STATE", "/dev/null"))
if not state.exists():
    sys.exit(0)

lines = []
for line in state.read_text().splitlines():
    parts = line.split("|")
    if parts and parts[0] == sys.argv[1]:
        parts[2] = "CANCELLED"
        line = "|".join(parts)
    lines.append(line)
state.write_text("\n".join(lines) + "\n")
