sequence:
    task:
        git_url: ssh://git@ben.ii.pw.edu.pl:9000/pwalas/swarm-gym.git
        ssh: hpc
        prepare:
            - cd swarm-gym
            - module load uv
            - uv sync
        sbatch: # 
            - job.sh
        check: # folder to sync with
            - swarm-gym/fly-to-point.log 
        time: # time period to check every second
            4:00:00